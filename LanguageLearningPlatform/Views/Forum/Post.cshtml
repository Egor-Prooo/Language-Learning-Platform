@model LanguageLearningPlatform.Services.Contracts.ForumPostViewModel

@{
    ViewData["Title"] = Model.Title;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAdmin = User.IsInRole("Admin");
    var isAuthor = currentUserId == Model.AuthorId;

    // Safe helper: HTML-encode content, then restore only safe newline → <br/> conversion.
    // This prevents XSS while still rendering line breaks the author intended.
    string SafeContent(string raw)
        => System.Net.WebUtility.HtmlEncode(raw ?? string.Empty).Replace("&#10;", "<br />");
}

<div class="container my-5">
    <div class="row g-4">

        <!-- Main Content -->
        <div class="col-lg-8">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb" style="font-size:0.85rem;">
                    <li class="breadcrumb-item"><a asp-action="Index">Forum</a></li>
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-route-category="@Model.Category">@Model.Category</a>
                    </li>
                    <li class="breadcrumb-item active text-truncate" style="max-width:200px;">@Model.Title</li>
                </ol>
            </nav>

            <!-- Post Card -->
            <div class="forum-post-detail">
                <div class="fpd-header">
                    <div class="d-flex align-items-start gap-3">
                        <div class="forum-avatar-lg">@Model.AuthorInitials</div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                @if (Model.IsPinned)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-thumbtack me-1"></i>Pinned
                                    </span>
                                }
                                @if (Model.IsClosed)
                                {
                                    <span class="badge bg-danger">
                                        <i class="fas fa-lock me-1"></i>Closed
                                    </span>
                                }
                                <span class="forum-badge-category-sm">@Model.Category</span>
                            </div>
                            <h1 class="fpd-title">@Model.Title</h1>
                            <div class="fpd-meta">
                                <span><i class="fas fa-user me-1"></i><strong>@Model.AuthorName</strong></span>
                                <span><i class="fas fa-calendar me-1"></i>@Model.CreatedAt.ToString("MMM dd, yyyy · HH:mm")</span>
                                <span><i class="fas fa-eye me-1"></i>@Model.Views views</span>
                                <span><i class="fas fa-comment me-1"></i><span id="reply-count">@Model.CommentCount</span> replies</span>
                            </div>
                        </div>

                        <!-- Post Actions -->
                        <div class="fpd-actions">
                            @if (isAdmin)
                            {
                                <form asp-action="TogglePin" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="postId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm @(Model.IsPinned ? "btn-warning" : "btn-outline-warning")" title="@(Model.IsPinned ? "Unpin" : "Pin")">
                                        <i class="fas fa-thumbtack"></i>
                                    </button>
                                </form>
                                <form asp-action="ToggleClose" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="postId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm @(Model.IsClosed ? "btn-danger" : "btn-outline-danger")" title="@(Model.IsClosed ? "Reopen" : "Close")">
                                        <i class="fas fa-@(Model.IsClosed ? "unlock" : "lock")"></i>
                                    </button>
                                </form>
                            }
                            @if (isAuthor || isAdmin)
                            {
                                <form asp-action="DeletePost" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="postId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"
                                            onclick="return confirm('Delete this post and all its replies?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>

                <!-- Post Body — SafeContent encodes all HTML then restores \n → <br /> only -->
                <div class="fpd-body">
                    @Html.Raw(SafeContent(Model.Content))
                </div>

                <!-- Post-level like button -->
                <div class="fpd-footer d-flex align-items-center gap-3 px-4 pb-4">
                    @if (isAuth)
                    {
                        <button class="btn-like"
                                onclick="likePost('@Model.Id', this)"
                                title="Like this post">
                            <i class="fas fa-heart me-1"></i>
                            <span class="like-count" id="post-likes">@Model.Likes</span>
                        </button>
                    }
                    else
                    {
                        <span class="text-muted small">
                            <i class="fas fa-heart me-1 text-danger"></i>
                            <span id="post-likes">@Model.Likes</span> likes
                        </span>
                    }

                    <!-- Live indicator -->
                    <span id="live-indicator" class="ms-auto" style="font-size:.72rem;color:#9CA3AF;display:none;">
                        <span style="display:inline-block;width:6px;height:6px;border-radius:50%;
                                     background:#10B981;margin-right:.4rem;
                                     animation:livePulse 2s ease-in-out infinite;"></span>
                        Live
                    </span>
                </div>
            </div>

            <!-- Replies -->
            <div class="mt-4">
                <h4 class="mb-3">
                    <i class="fas fa-comments me-2 text-primary"></i>
                    <span id="reply-heading">@Model.CommentCount @(Model.CommentCount == 1 ? "Reply" : "Replies")</span>
                </h4>

                @if (!Model.Comments.Any())
                {
                    <div class="forum-no-replies" id="no-replies-placeholder">
                        <i class="fas fa-comment-dots me-2"></i>
                        No replies yet. Be the first to respond!
                    </div>
                }

                <div class="forum-comments" id="comments-container">
                    @foreach (var comment in Model.Comments)
                    {
                        <div class="forum-comment" id="comment-@comment.Id" data-comment-id="@comment.Id">
                            <div class="forum-avatar-sm">@comment.AuthorInitials</div>
                            <div class="forum-comment-body flex-grow-1">
                                <div class="forum-comment-header">
                                    <strong class="forum-comment-author">@comment.AuthorName</strong>
                                    <span class="forum-comment-time">@comment.CreatedAt.ToString("MMM dd, yyyy · HH:mm")</span>

                                    <div class="ms-auto d-flex align-items-center gap-2">
                                        @if (isAuth)
                                        {
                                            <button class="btn-like btn-like-sm"
                                                    onclick="likeComment('@comment.Id', this)"
                                                    title="Like">
                                                <i class="fas fa-heart"></i>
                                                <span class="like-count">@comment.Likes</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size:0.75rem;">
                                                <i class="fas fa-heart text-danger me-1"></i>
                                                <span class="comment-like-count-@comment.Id">@comment.Likes</span>
                                            </span>
                                        }

                                        @if (comment.AuthorId == currentUserId || isAdmin)
                                        {
                                            <form asp-action="DeleteComment" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="commentId" value="@comment.Id" />
                                                <input type="hidden" name="postId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-xs btn-link text-danger p-0"
                                                        title="Delete" onclick="return confirm('Delete this reply?')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                                <!-- Comment content — same SafeContent encoding applied -->
                                <div class="forum-comment-content">
                                    @Html.Raw(SafeContent(comment.Content))
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Reply Box -->
            @if (isAuth && !Model.IsClosed)
            {
                <div class="forum-reply-box mt-4">
                    <h5 class="mb-3"><i class="fas fa-reply me-2 text-primary"></i>Write a Reply</h5>
                    <form asp-action="Comment" method="post" id="comment-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@Model.Id" />
                        <textarea name="content" id="comment-textarea" class="form-control forum-textarea" rows="5"
                              placeholder="Share your thoughts, ask a question, or help others..." required></textarea>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="text-muted small">
                                <i class="fas fa-info-circle me-1"></i>Be respectful and helpful
                            </span>
                            <button type="submit" class="btn btn-primary px-4" id="submit-comment-btn">
                                <i class="fas fa-paper-plane me-2"></i>Post Reply
                            </button>
                        </div>
                    </form>
                </div>
            }
            else if (!isAuth)
            {
                <div class="forum-login-prompt mt-4">
                    <i class="fas fa-lock me-2"></i>
                    <a asp-area="Identity" asp-page="/Account/Login">Sign in</a> to join the conversation.
                </div>
            }
            else if (Model.IsClosed)
            {
                <div class="forum-closed-prompt mt-4">
                    <i class="fas fa-lock me-2"></i>This thread is closed for new replies.
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="forum-sidebar-widget">
                <div class="fsw-title"><i class="fas fa-info-circle me-2 text-primary"></i>Post Info</div>
                <div class="fsw-row"><span>Category</span><strong>@Model.Category</strong></div>
                <div class="fsw-row"><span>Posted</span><strong>@Model.CreatedAt.ToString("MMM dd, yyyy")</strong></div>
                <div class="fsw-row"><span>Views</span><strong>@Model.Views</strong></div>
                <div class="fsw-row"><span>Replies</span><strong id="sidebar-reply-count">@Model.CommentCount</strong></div>
                <div class="fsw-row"><span>Likes</span><strong id="sidebar-post-likes">@Model.Likes</strong></div>
                <div class="fsw-row">
                    <span>Status</span>
                    <strong>
                        @if (Model.IsClosed)
                        {
                            <span class="text-danger">Closed</span>
                        }
                        else
                        {
                            <span class="text-success">Open</span>
                        }
                    </strong>
                </div>
                <div class="mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 btn-sm">
                        <i class="fas fa-arrow-left me-2"></i>Back to Forum
                    </a>
                    @if (isAuth)
                    {
                        <a asp-action="Create" class="btn btn-primary w-100 btn-sm mt-2">
                            <i class="fas fa-pen me-2"></i>New Post
                        </a>
                    }
                </div>
            </div>

            <!-- Browse Categories -->
            <div class="forum-sidebar-widget mt-3">
                <div class="fsw-title"><i class="fas fa-tags me-2 text-primary"></i>Browse Categories</div>
                @foreach (var cat in (ViewBag.Categories as IEnumerable<string> ?? Enumerable.Empty<string>()))
                {
                    <a asp-action="Index" asp-route-category="@cat"
                       class="forum-category-link @(Model.Category == cat ? "active" : "")">
                        @cat
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .forum-post-detail {
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        overflow: hidden;
    }

    .fpd-header {
        padding: 1.75rem;
        border-bottom: 2px solid #F3F4F6;
    }

    .fpd-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #1F2937;
        margin: 0.5rem 0;
        line-height: 1.3;
    }

    .fpd-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        font-size: 0.82rem;
        color: #6B7280;
    }

    .fpd-body {
        padding: 1.75rem;
        font-size: 1rem;
        color: #374151;
        line-height: 1.8;
    }

    .fpd-footer {
        border-top: 1px solid #F3F4F6;
        padding-top: 1rem;
    }

    .fpd-actions {
        display: flex;
        gap: 0.4rem;
        flex-shrink: 0;
    }

    .forum-avatar-lg {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4F46E5, #7C3AED);
        color: white;
        font-weight: 700;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .forum-avatar-sm {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #10B981, #059669);
        color: white;
        font-weight: 700;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .forum-no-replies {
        background: #F9FAFB;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        color: #9CA3AF;
        border: 2px dashed #E5E7EB;
    }

    .forum-comments {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .forum-comment {
        display: flex;
        gap: 1rem;
        background: white;
        border-radius: 14px;
        padding: 1.25rem;
        border: 2px solid #F3F4F6;
        transition: border-color 0.2s;
        animation: commentSlideIn 0.35s ease;
    }

        .forum-comment:hover {
            border-color: #E0E7FF;
        }

    @@keyframes commentSlideIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes livePulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.4;
        }
    }

    .forum-comment-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.6rem;
        flex-wrap: wrap;
    }

    .forum-comment-author {
        color: #1F2937;
        font-size: 0.9rem;
    }

    .forum-comment-time {
        color: #9CA3AF;
        font-size: 0.78rem;
    }

    .forum-comment-content {
        color: #374151;
        font-size: 0.92rem;
        line-height: 1.7;
    }

    /* Like buttons */
    .btn-like {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #FEE2E2;
        color: #DC2626;
        border: 1.5px solid #FECACA;
        border-radius: 20px;
        padding: 0.4rem 0.9rem;
        font-weight: 700;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all 0.2s;
        outline: none;
    }

        .btn-like:hover {
            background: #EF4444;
            color: white;
            border-color: #EF4444;
            transform: scale(1.05);
        }

        .btn-like.liked {
            background: #EF4444;
            color: white;
            border-color: #EF4444;
        }

    .btn-like-sm {
        padding: 0.2rem 0.6rem;
        font-size: 0.75rem;
        border-radius: 12px;
    }

    .forum-reply-box {
        background: white;
        border-radius: 16px;
        padding: 1.75rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.07);
    }

    .forum-textarea {
        border: 2px solid #E5E7EB;
        border-radius: 12px;
        font-size: 0.95rem;
        transition: border-color 0.2s;
        resize: vertical;
    }

        .forum-textarea:focus {
            border-color: #4F46E5;
            box-shadow: none;
        }

    .forum-login-prompt, .forum-closed-prompt {
        background: #F9FAFB;
        border-radius: 12px;
        padding: 1.25rem;
        color: #6B7280;
        border: 2px dashed #E5E7EB;
        text-align: center;
    }

    .forum-sidebar-widget {
        background: white;
        border-radius: 14px;
        padding: 1.25rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .fsw-title {
        font-weight: 700;
        font-size: 0.9rem;
        color: #1F2937;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #F3F4F6;
    }

    .fsw-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #F9FAFB;
        font-size: 0.85rem;
        color: #6B7280;
    }

    .forum-category-link {
        display: flex;
        align-items: center;
        padding: 0.5rem 0.6rem;
        border-radius: 8px;
        color: #4B5563;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.15s;
        margin-bottom: 2px;
    }

        .forum-category-link:hover {
            background: #F3F4F6;
            color: #4F46E5;
        }

        .forum-category-link.active {
            background: #EEF2FF;
            color: #4F46E5;
            font-weight: 700;
        }

    .forum-badge-category-sm {
        background: #EEF2FF;
        color: #4F46E5;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
    }

    /* New comment toast */
    .new-comment-toast {
        position: fixed;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        background: #4F46E5;
        color: white;
        padding: .65rem 1.5rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: .85rem;
        box-shadow: 0 4px 20px rgba(79,70,229,.4);
        z-index: 9999;
        animation: toastIn .3s ease;
    }

    @@keyframes toastIn {
        from {
            opacity: 0;
            transform: translate(-50%, 20px);
        }

        to {
            opacity: 1;
            transform: translate(-50%, 0);
        }
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        (function () {
            const POST_ID      = '@Model.Id';
            const CURRENT_USER = '@Html.Raw(currentUserId ?? "")';
            const IS_AUTH      = @(isAuth ? "true" : "false");
            const IS_ADMIN     = @(isAdmin ? "true" : "false");

            // ── SignalR connection ────────────────────────────────────────────
            const conn = new signalR.HubConnectionBuilder()
                .withUrl('/forumHub')
                .withAutomaticReconnect([0, 2000, 5000, 10000])
                .build();

            conn.on('ReceiveComment', function (comment) {
                if (document.getElementById('comment-' + comment.id)) return;

                appendComment(comment);
                incrementReplyCount();
                if (comment.authorId !== CURRENT_USER) {
                    showToast('💬 New reply from ' + escHtml(comment.authorName));
                }
            });

            conn.on('CommentLikeUpdated', function (data) {
                const el = document.querySelector(`[data-comment-id="${data.commentId}"] .like-count`);
                if (el) el.textContent = data.likes;
                const staticEl = document.querySelector(`.comment-like-count-${data.commentId}`);
                if (staticEl) staticEl.textContent = data.likes;
            });

            conn.on('PostLikeUpdated', function (data) {
                if (data.postId !== POST_ID) return;
                const postLikes = document.getElementById('post-likes');
                if (postLikes) postLikes.textContent = data.likes;
                const sidebar = document.getElementById('sidebar-post-likes');
                if (sidebar) sidebar.textContent = data.likes;
            });

            conn.on('CommentDeleted', function (commentId) {
                const el = document.getElementById('comment-' + commentId);
                if (el) {
                    el.style.transition = 'opacity .3s, transform .3s';
                    el.style.opacity = '0';
                    el.style.transform = 'translateX(20px)';
                    setTimeout(() => {
                        el.remove();
                        decrementReplyCount();
                    }, 300);
                }
            });

            async function start() {
                try {
                    await conn.start();
                    await conn.invoke('JoinPost', POST_ID);
                    document.getElementById('live-indicator').style.display = 'inline-flex';
                } catch (err) {
                    console.warn('ForumHub connect failed, retrying…', err);
                    setTimeout(start, 5000);
                }
            }
            start();

            // ── Reply count helpers ───────────────────────────────────────────
            let replyCount = @Model.CommentCount;

            function incrementReplyCount() {
                replyCount++;
                updateReplyCountUI();
            }
            function decrementReplyCount() {
                replyCount = Math.max(0, replyCount - 1);
                updateReplyCountUI();
            }
            function updateReplyCountUI() {
                const label = replyCount === 1 ? 'Reply' : 'Replies';
                const heading = document.getElementById('reply-heading');
                if (heading) heading.textContent = `${replyCount} ${label}`;
                const inlineCount = document.getElementById('reply-count');
                if (inlineCount) inlineCount.textContent = replyCount;
                const sidebarCount = document.getElementById('sidebar-reply-count');
                if (sidebarCount) sidebarCount.textContent = replyCount;
            }

            // ── Append a new comment card ─────────────────────────────────────
            function appendComment(comment) {
                const placeholder = document.getElementById('no-replies-placeholder');
                if (placeholder) placeholder.remove();

                const container = document.getElementById('comments-container');
                if (!container) return;

                const initials = comment.authorInitials ||
                    comment.authorName.split(' ').slice(0, 2).map(w => w[0].toUpperCase()).join('');

                const canDelete = IS_AUTH && (comment.authorId === CURRENT_USER || IS_ADMIN);
                const deleteHtml = canDelete
                    ? `<form action="/Forum/DeleteComment" method="post" class="d-inline"
                           onsubmit="return confirm('Delete this reply?')">
                           <input type="hidden" name="commentId" value="${escHtml(comment.id)}" />
                           <input type="hidden" name="postId"    value="${escHtml(POST_ID)}" />
                           <input type="hidden" name="__RequestVerificationToken"
                                  value="${escHtml(getAntiForgeryToken())}" />
                           <button type="submit" class="btn btn-xs btn-link text-danger p-0" title="Delete">
                               <i class="fas fa-times"></i>
                           </button>
                       </form>`
                    : '';

                const likeHtml = IS_AUTH
                    ? `<button class="btn-like btn-like-sm"
                               onclick="likeComment('${escHtml(comment.id)}', this)" title="Like">
                           <i class="fas fa-heart"></i>
                           <span class="like-count">${escHtml(String(comment.likes))}</span>
                       </button>`
                    : `<span class="text-muted" style="font-size:0.75rem;">
                           <i class="fas fa-heart text-danger me-1"></i>
                           <span class="comment-like-count-${escHtml(comment.id)}">${escHtml(String(comment.likes))}</span>
                       </span>`;

                const div = document.createElement('div');
                div.className = 'forum-comment';
                div.id = 'comment-' + comment.id;
                div.dataset.commentId = comment.id;
                // Content is text-only here — the server already HTML-encoded it on save;
                // we use escHtml on the SignalR payload values so no raw HTML can slip in
                // through the real-time path either.
                div.innerHTML = `
                    <div class="forum-avatar-sm">${escHtml(initials)}</div>
                    <div class="forum-comment-body flex-grow-1">
                        <div class="forum-comment-header">
                            <strong class="forum-comment-author">${escHtml(comment.authorName)}</strong>
                            <span class="forum-comment-time">${escHtml(comment.createdAt)}</span>
                            <div class="ms-auto d-flex align-items-center gap-2">
                                ${likeHtml}
                                ${deleteHtml}
                            </div>
                        </div>
                        <div class="forum-comment-content">${escHtml(comment.content).replace(/\n/g, '<br />')}</div>
                    </div>`;
                container.appendChild(div);
            }

            // ── Toast ─────────────────────────────────────────────────────────
            function showToast(message) {
                const t = document.createElement('div');
                t.className = 'new-comment-toast';
                // message is already produced by escHtml above, safe to set as text
                t.textContent = message;
                document.body.appendChild(t);
                setTimeout(() => {
                    t.style.transition = 'opacity .4s, transform .4s';
                    t.style.opacity = '0';
                    t.style.transform = 'translate(-50%, 16px)';
                    setTimeout(() => t.remove(), 400);
                }, 3000);
            }

            // ── Helpers ───────────────────────────────────────────────────────
            // escHtml: convert a plain string to HTML-safe text for insertion into innerHTML
            function escHtml(str) {
                const d = document.createElement('div');
                d.textContent = String(str ?? '');
                return d.innerHTML;
            }

            function getAntiForgeryToken() {
                return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            }

        })();

        // ── Like helpers (called from inline onclick) ─────────────────────────
        async function likeComment(commentId, btn) {
            try {
                const res = await fetch('/Forum/LikeComment', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ commentId })
                });
                if (res.ok) {
                    const data = await res.json();
                    btn.querySelector('.like-count').textContent = data.likes;
                    btn.classList.add('liked');
                    btn.disabled = true;
                }
            } catch (e) { console.error('Like comment failed', e); }
        }

        async function likePost(postId, btn) {
            try {
                const res = await fetch('/Forum/LikePost', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ postId })
                });
                if (res.ok) {
                    const data = await res.json();
                    btn.querySelector('.like-count').textContent = data.likes;
                    btn.classList.add('liked');
                    btn.disabled = true;
                }
            } catch (e) { console.error('Like post failed', e); }
        }
    </script>
}
