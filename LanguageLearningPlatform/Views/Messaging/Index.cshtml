@using LanguageLearningPlatform.Web.Controllers
@model IEnumerable<StudentCourseGroupViewModel>

@{
    ViewData["Title"] = "Messages";
    var courseGroups = Model.ToList();
    var selected = ViewBag.Selected as StudentTeacherItemViewModel;
    var selectedTeacherId = ViewBag.SelectedTeacherId as string ?? "";
    var selectedCourseId = ViewBag.SelectedCourseId is Guid g ? g.ToString() : "";
    var studentId = ViewBag.StudentId as string ?? "";

    string? activeTeacherId = selected?.TeacherId;
    Guid? activeCourseId = selected?.CourseId;
    string? activeTeacherName = selected?.TeacherName;
    string? activeInitials = selected?.TeacherInitials;
    string? activeCourseName = courseGroups
        .FirstOrDefault(cg => cg.CourseId == selected?.CourseId)?.CourseName;
    bool hasActiveConv = activeTeacherId != null && activeCourseId.HasValue;
}

@section Styles {
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

        .msg-root {
            font-family: 'Manrope', sans-serif;
            height: calc(100vh - 66px);
            display: flex;
            background: #F2F0EB;
            overflow: hidden;
        }

        /* ── Sidebar ─────────────────────────────────────────────── */
        .msg-sidebar {
            width: 320px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            background: #1A1916;
            height: 100%;
        }

        .msg-sidebar-head {
            padding: 1.5rem 1.25rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,.06);
            flex-shrink: 0;
        }

        .msg-sidebar-label {
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: rgba(255,255,255,.3);
            margin-bottom: .6rem;
        }

        .msg-search {
            position: relative;
        }

        .msg-search-input {
            width: 100%;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 10px;
            padding: .55rem .85rem .55rem 2.2rem;
            font-size: .82rem;
            color: rgba(255,255,255,.8);
            font-family: 'Manrope', sans-serif;
            outline: none;
            transition: border-color .2s;
        }

            .msg-search-input::placeholder {
                color: rgba(255,255,255,.25);
            }

            .msg-search-input:focus {
                border-color: rgba(255,255,255,.2);
            }

        .msg-search-icon {
            position: absolute;
            left: .75rem;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255,255,255,.25);
            font-size: .75rem;
        }

        .msg-sidebar-scroll {
            flex: 1;
            overflow-y: auto;
            padding: .5rem 0 1rem;
        }

            .msg-sidebar-scroll::-webkit-scrollbar {
                width: 4px;
            }

            .msg-sidebar-scroll::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.1);
                border-radius: 4px;
            }

        /* ── Course group ─────────────────────────────────────────── */
        .msg-course-group {
            margin-bottom: .25rem;
        }

        .msg-course-header {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .65rem 1.25rem;
            cursor: pointer;
            user-select: none;
            position: sticky;
            top: 0;
            background: #1A1916;
            z-index: 1;
            transition: background .15s;
        }

            .msg-course-header:hover {
                background: rgba(255,255,255,.04);
            }

        .msg-course-icon {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: rgba(255,255,255,.06);
            color: rgba(255,255,255,.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .65rem;
            flex-shrink: 0;
        }

        .msg-course-name {
            flex: 1;
            font-size: .78rem;
            font-weight: 700;
            color: rgba(255,255,255,.55);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .msg-course-badge {
            background: rgba(255,255,255,.08);
            color: rgba(255,255,255,.3);
            font-size: .6rem;
            font-weight: 800;
            padding: .1rem .45rem;
            border-radius: 7px;
        }

            .msg-course-badge.has-unread {
                background: rgba(232,201,122,.15);
                color: #C8A855;
            }

        .msg-course-chevron {
            color: rgba(255,255,255,.2);
            font-size: .65rem;
            transition: transform .2s;
            flex-shrink: 0;
        }

        .msg-course-group.open .msg-course-chevron {
            transform: rotate(90deg);
        }

        .msg-teacher-list {
            display: none;
        }

        .msg-course-group.open .msg-teacher-list {
            display: block;
        }

        /* ── Teacher item inside a course group ───────────────────── */
        .msg-teacher-item {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .7rem 1.25rem .7rem 2.2rem;
            cursor: pointer;
            text-decoration: none;
            border-left: 3px solid transparent;
            transition: background .12s;
            position: relative;
        }

            .msg-teacher-item:hover {
                background: rgba(255,255,255,.04);
            }

            .msg-teacher-item.active {
                background: rgba(232,201,122,.07);
                border-left-color: #E8C97A;
            }

        .msg-teacher-avatar {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: rgba(255,255,255,.08);
            color: rgba(255,255,255,.5);
            font-weight: 800;
            font-size: .72rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            position: relative;
        }

        .msg-teacher-item.active .msg-teacher-avatar {
            background: rgba(232,201,122,.12);
            color: #E8C97A;
        }

        .msg-unread-dot {
            position: absolute;
            top: -2px;
            right: -2px;
            width: 9px;
            height: 9px;
            background: #E8C97A;
            border-radius: 50%;
            border: 2px solid #1A1916;
        }

        .msg-teacher-body {
            flex: 1;
            min-width: 0;
        }

        .msg-teacher-name {
            font-size: .8rem;
            font-weight: 700;
            color: rgba(255,255,255,.7);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .msg-teacher-item.active .msg-teacher-name {
            color: #E8C97A;
        }

        .msg-teacher-preview {
            font-size: .68rem;
            color: rgba(255,255,255,.25);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: .1rem;
        }

        .msg-teacher-meta {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: .2rem;
            flex-shrink: 0;
        }

        .msg-teacher-time {
            font-size: .6rem;
            color: rgba(255,255,255,.2);
        }

        .msg-teacher-badge {
            background: #E8C97A;
            color: #1A1916;
            font-size: .58rem;
            font-weight: 800;
            padding: .1rem .38rem;
            border-radius: 7px;
        }

        .msg-new-badge {
            font-size: .58rem;
            font-weight: 700;
            background: rgba(45,212,191,.12);
            color: #2DD4BF;
            padding: .1rem .4rem;
            border-radius: 6px;
            margin-left: auto;
        }

        /* ── Chat area ───────────────────────────────────────────── */
        .msg-chat {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100%;
            min-width: 0;
            background: #F2F0EB;
        }

        .msg-chat-header {
            background: #FDFCFA;
            border-bottom: 1px solid #E8E5DE;
            padding: 1rem 1.75rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-shrink: 0;
        }

        .msg-chat-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, #4A3F2F, #7A6545);
            color: #E8C97A;
            font-weight: 800;
            font-size: .85rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .msg-chat-name {
            font-weight: 800;
            font-size: 1rem;
            color: #1A1916;
        }

        .msg-chat-subtitle {
            font-size: .75rem;
            color: #9C9484;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        .msg-online-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #3DC47E;
            animation: onlinePulse 2s ease-in-out infinite;
        }

        @@keyframes onlinePulse {
            0%, 100% {
                opacity: 1
            }

            50% {
                opacity: .4
            }
        }

        .msg-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem 1.75rem;
            display: flex;
            flex-direction: column;
            gap: .5rem;
        }

            .msg-messages::-webkit-scrollbar {
                width: 4px;
            }

            .msg-messages::-webkit-scrollbar-thumb {
                background: #D8D4CB;
                border-radius: 4px;
            }

        .msg-date-sep {
            text-align: center;
            position: relative;
            margin: .75rem 0;
        }

            .msg-date-sep::before {
                content: '';
                position: absolute;
                left: 0;
                right: 0;
                top: 50%;
                height: 1px;
                background: #E2DEDD;
            }

            .msg-date-sep span {
                position: relative;
                background: #F2F0EB;
                padding: 0 .75rem;
                font-size: .65rem;
                color: #B0A99E;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .06em;
            }

        .msg-row {
            display: flex;
            align-items: flex-end;
            gap: .5rem;
            max-width: 75%;
        }

            .msg-row.from-me {
                flex-direction: row-reverse;
                align-self: flex-end;
                margin-left: auto;
            }

            .msg-row.from-them {
                align-self: flex-start;
            }

        .msg-bubble-avatar {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: linear-gradient(135deg, #4A3F2F, #7A6545);
            color: #E8C97A;
            font-weight: 800;
            font-size: .6rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-bottom: 2px;
        }

        .msg-bubble {
            padding: .75rem 1rem;
            border-radius: 18px;
            font-size: .875rem;
            line-height: 1.5;
            word-break: break-word;
        }

        .msg-row.from-them .msg-bubble {
            background: #FDFCFA;
            color: #1A1916;
            border: 1px solid #E8E5DE;
            border-bottom-left-radius: 4px;
        }

        .msg-row.from-me .msg-bubble {
            background: #1A1916;
            color: #F2F0EB;
            border-bottom-right-radius: 4px;
        }

        .msg-time {
            font-size: .6rem;
            color: #B0A99E;
            margin-top: .25rem;
            display: block;
        }

        .msg-row.from-me .msg-time {
            text-align: right;
        }

        .msg-typing {
            display: none;
            align-items: center;
            gap: .5rem;
            padding: 0 1.75rem .25rem;
        }

            .msg-typing.visible {
                display: flex;
            }

        .msg-typing-dots {
            display: flex;
            gap: 3px;
            background: #FDFCFA;
            border: 1px solid #E8E5DE;
            border-radius: 14px;
            padding: .55rem .85rem;
        }

        .msg-typing-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #C8C0B6;
            animation: typingBounce .8s ease-in-out infinite;
        }

            .msg-typing-dot:nth-child(2) {
                animation-delay: .15s;
            }

            .msg-typing-dot:nth-child(3) {
                animation-delay: .3s;
            }

        @@keyframes typingBounce {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-5px)
            }
        }

        .msg-input-area {
            background: #FDFCFA;
            border-top: 1px solid #E8E5DE;
            padding: 1rem 1.75rem;
            flex-shrink: 0;
        }

        .msg-input-wrap {
            display: flex;
            align-items: flex-end;
            gap: .75rem;
            background: #F2F0EB;
            border: 1.5px solid #E2DEDD;
            border-radius: 16px;
            padding: .7rem 1rem;
            transition: border-color .2s, box-shadow .2s;
        }

            .msg-input-wrap:focus-within {
                border-color: #C8A855;
                box-shadow: 0 0 0 3px rgba(200,168,85,.12);
                background: #FDFCFA;
            }

        .msg-textarea {
            flex: 1;
            border: none;
            background: transparent;
            outline: none;
            resize: none;
            font-size: .9rem;
            font-family: 'Manrope', sans-serif;
            color: #1A1916;
            max-height: 120px;
            line-height: 1.5;
            padding: 0;
        }

            .msg-textarea::placeholder {
                color: #B0A99E;
            }

        .msg-send-btn {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: #1A1916;
            border: none;
            color: #E8C97A;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .2s;
            flex-shrink: 0;
            font-size: .85rem;
        }

            .msg-send-btn:hover:not(:disabled) {
                background: #292524;
                transform: scale(1.05);
            }

            .msg-send-btn:disabled {
                background: #E2DEDD;
                color: #B0A99E;
                cursor: not-allowed;
                transform: none;
            }

        .msg-empty {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 1rem;
            text-align: center;
            padding: 2rem;
        }

        .msg-empty-icon {
            font-size: 3rem;
            opacity: .15;
            color: #4A3F2F;
            margin-bottom: .5rem;
        }

        .msg-empty h4 {
            font-weight: 800;
            color: #4A3F2F;
            margin: 0;
        }

        .msg-empty p {
            font-size: .9rem;
            color: #9C9484;
            margin: 0;
        }

        .msg-new-chat-banner {
            background: linear-gradient(135deg, #2D2820, #1A1916);
            border-radius: 16px;
            padding: 1.5rem 2rem;
            margin: 1.5rem;
            text-align: center;
            border: 1px solid rgba(232,201,122,.15);
        }

            .msg-new-chat-banner .icon {
                font-size: 2rem;
                color: #E8C97A;
                margin-bottom: .75rem;
                display: block;
            }

            .msg-new-chat-banner h5 {
                color: #F2F0EB;
                font-weight: 800;
                margin-bottom: .3rem;
            }

            .msg-new-chat-banner p {
                color: rgba(255,255,255,.4);
                font-size: .85rem;
                margin: 0;
            }

        .msg-send-error {
            font-size: .72rem;
            color: #EF4444;
            padding: .4rem 0;
            text-align: right;
            display: none;
        }

        @@media (max-width: 768px) {
            .msg-sidebar {
                width: 100%;
                height: 280px;
            }

            .msg-root {
                flex-direction: column;
                height: auto;
            }

            .msg-chat {
                height: calc(100vh - 346px);
            }
        }
    </style>
}

<div class="msg-root">

    <!-- ═══════════════════ SIDEBAR ═══════════════════ -->
    <div class="msg-sidebar">
        <div class="msg-sidebar-head">
            <div class="msg-sidebar-label">Messages</div>
            <div class="msg-search">
                <i class="fas fa-search msg-search-icon"></i>
                <input class="msg-search-input" type="text" id="convSearch"
                       placeholder="Search teachers or courses…" autocomplete="off" />
            </div>
        </div>

        <div class="msg-sidebar-scroll" id="sidebarScroll">

            @if (!courseGroups.Any())
            {
                <div style="text-align:center;padding:2.5rem 1.25rem;">
                    <i class="fas fa-inbox" style="font-size:2.5rem;color:rgba(255,255,255,.1);display:block;margin-bottom:.75rem;"></i>
                    <p style="font-size:.78rem;color:rgba(255,255,255,.25);margin:0;">
                        Enroll in a course to message its teacher
                    </p>
                </div>
            }

            @foreach (var cg in courseGroups)
            {
                // Auto-open the group that contains the selected teacher
                bool isOpen = cg.Teachers.Any(t =>
                t.TeacherId == selectedTeacherId &&
                t.CourseId.ToString() == selectedCourseId);

                // Also open if no conversation is selected yet (so the sidebar isn't a wall of closed groups)
                if (!isOpen && string.IsNullOrEmpty(selectedTeacherId))
                    isOpen = true;

                <div class="msg-course-group @(isOpen ? "open" : "")" data-course-id="@cg.CourseId">
                    <div class="msg-course-header" onclick="toggleGroup(this.parentElement)">
                        <div class="msg-course-icon"><i class="fas fa-book"></i></div>
                        <div class="msg-course-name" title="@cg.CourseName">@cg.CourseName</div>
                        @if (cg.TotalUnread > 0)
                        {
                            <span class="msg-course-badge has-unread">@cg.TotalUnread</span>
                        }
                        else
                        {
                            <span class="msg-course-badge">@cg.Teachers.Count</span>
                        }
                        <i class="fas fa-chevron-right msg-course-chevron"></i>
                    </div>

                    <div class="msg-teacher-list">
                        @foreach (var teacher in cg.Teachers)
                        {
                            bool isActive = teacher.TeacherId == selectedTeacherId
                            && teacher.CourseId.ToString() == selectedCourseId;

                            string timeStr = "";
                            if (teacher.HasMessages && teacher.LastMessageAt.HasValue)
                            {
                                var lat = teacher.LastMessageAt.Value;
                                timeStr = lat.Date == DateTime.Today ? lat.ToString("HH:mm")
                                : lat.Date == DateTime.Today.AddDays(-1) ? "Yesterday"
                                : lat.ToString("MMM d");
                            }

                            <a href="@Url.Action("Index", "Messaging", new { teacherId = teacher.TeacherId, courseId = teacher.CourseId })"
                               class="msg-teacher-item @(isActive ? "active" : "")"
                               data-search="@teacher.TeacherName.ToLower() @cg.CourseName.ToLower()">

                                <div class="msg-teacher-avatar">
                                    @teacher.TeacherInitials
                                    @if (teacher.UnreadCount > 0)
                                    {
                                        <div class="msg-unread-dot"></div>
                                    }
                                </div>

                                <div class="msg-teacher-body">
                                    <div class="msg-teacher-name">@teacher.TeacherName</div>
                                    @if (teacher.HasMessages)
                                    {
                                        <div class="msg-teacher-preview">@teacher.LastMessage</div>
                                    }
                                    else
                                    {
                                        <div class="msg-teacher-preview" style="font-style:italic;color:rgba(255,255,255,.18);">
                                            No messages yet
                                        </div>
                                    }
                                </div>

                                <div class="msg-teacher-meta">
                                    @if (teacher.HasMessages)
                                    {
                                        <span class="msg-teacher-time">@timeStr</span>
                                        @if (teacher.UnreadCount > 0)
                                        {
                                            <span class="msg-teacher-badge">@teacher.UnreadCount</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="msg-new-badge">New</span>
                                    }
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ═══════════════════ CHAT PANEL ════════════════ -->
    <div class="msg-chat">

        @if (hasActiveConv)
        {
            <!-- Chat header -->
            <div class="msg-chat-header">
                <div class="msg-chat-avatar">@activeInitials</div>
                <div style="flex:1;min-width:0;">
                    <div class="msg-chat-name">@activeTeacherName</div>
                    <div class="msg-chat-subtitle">
                        <span class="msg-online-dot"></span>
                        @activeCourseName
                    </div>
                </div>
                <a asp-controller="Courses" asp-action="Details" asp-route-id="@activeCourseId"
                   style="font-size:.75rem;font-weight:700;color:#9C9484;text-decoration:none;
                              padding:.4rem .85rem;border:1px solid #E8E5DE;border-radius:8px;
                              background:#F2F0EB;transition:all .15s;"
                   onmouseover="this.style.borderColor='#C8A855';this.style.color='#7A6545';"
                   onmouseout="this.style.borderColor='#E8E5DE';this.style.color='#9C9484';">
                    <i class="fas fa-arrow-up-right-from-square me-1"></i>Course
                </a>
            </div>

            <!-- Messages -->
            <div class="msg-messages" id="messagesArea">

                @if (selected != null && !selected.Messages.Any())
                {
                    <div class="msg-new-chat-banner">
                        <span class="icon"><i class="fas fa-comment-dots"></i></span>
                        <h5>Start the conversation</h5>
                        <p>Send your first message to @activeTeacherName</p>
                    </div>
                }
                else if (selected != null)
                {
                    DateTime? lastDate = null;
                    foreach (var msg in selected.Messages)
                    {
                        var msgDate = msg.SentAt.Date;
                        if (lastDate == null || lastDate != msgDate)
                        {
                            var label = msgDate == DateTime.Today ? "Today"
                            : msgDate == DateTime.Today.AddDays(-1) ? "Yesterday"
                            : msgDate.ToString("MMMM d, yyyy");
                            <div class="msg-date-sep"><span>@label</span></div>
                            lastDate = msgDate;
                        }

                        bool fromMe = !msg.IsFromTeacher;
                        <div class="msg-row @(fromMe ? "from-me" : "from-them")">
                            @if (!fromMe)
                            {
                                <div class="msg-bubble-avatar">@activeInitials</div>
                            }
                            <div>
                                <div class="msg-bubble">@msg.Message</div>
                                <span class="msg-time">@msg.SentAt.ToString("HH:mm")</span>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Typing indicator -->
            <div class="msg-typing" id="typingIndicator" style="padding:0 1.75rem .25rem;">
                <div class="msg-bubble-avatar">@activeInitials</div>
                <div class="msg-typing-dots">
                    <div class="msg-typing-dot"></div>
                    <div class="msg-typing-dot"></div>
                    <div class="msg-typing-dot"></div>
                </div>
            </div>

            <!-- Input -->
            <div class="msg-input-area">
                <div class="msg-input-wrap">
                    <textarea class="msg-textarea" id="msgInput" rows="1"
                          placeholder="Message @activeTeacherName…"
                          maxlength="2000"></textarea>
                    <button class="msg-send-btn" id="sendBtn" disabled title="Send (Enter)">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
                <div style="display:flex;justify-content:space-between;margin-top:.4rem;">
                    <span class="msg-send-error" id="sendError">
                        <i class="fas fa-exclamation-circle me-1"></i>Failed to send. Please retry.
                    </span>
                    <span style="font-size:.68rem;color:#B0A99E;margin-left:auto;">
                        <kbd style="background:#E8E5DE;border-radius:4px;padding:.1rem .3rem;font-size:.68rem;">Enter</kbd>
                        to send &nbsp;·&nbsp;
                        <kbd style="background:#E8E5DE;border-radius:4px;padding:.1rem .3rem;font-size:.68rem;">Shift+Enter</kbd>
                        for new line
                    </span>
                </div>
            </div>
        }
        else
        {
            <div class="msg-empty">
                <div class="msg-empty-icon"><i class="fas fa-comments"></i></div>
                <h4>No conversation selected</h4>
                <p>
                    @if (!courseGroups.Any())
                    {
                        <text>Enroll in a course to message its teacher.</text>
                    }
                    else
                    {
                        <text>Pick a teacher from the sidebar to start chatting.</text>
                    }
                </p>
                @if (!courseGroups.Any())
                {
                    <a asp-controller="Courses" asp-action="Index"
                       class="btn btn-sm mt-2"
                       style="background:#1A1916;color:#E8C97A;border-radius:10px;font-weight:700;
                                      padding:.65rem 1.5rem;text-decoration:none;font-size:.85rem;">
                        <i class="fas fa-compass me-2"></i>Browse Courses
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        (function () {
            const TEACHER_ID  = '@Html.Raw(activeTeacherId ?? "")';
            const STUDENT_ID  = '@Html.Raw(studentId)';
            const COURSE_ID   = '@Html.Raw(activeCourseId?.ToString() ?? "")';
            const TEACHER_INI = '@Html.Raw(activeInitials ?? "")';
            const hasConv     = TEACHER_ID && STUDENT_ID && COURSE_ID;

            const messagesArea    = document.getElementById('messagesArea');
            const msgInput        = document.getElementById('msgInput');
            const sendBtn         = document.getElementById('sendBtn');
            const typingIndicator = document.getElementById('typingIndicator');
            const sendError       = document.getElementById('sendError');

            function scrollBottom() {
                if (messagesArea) messagesArea.scrollTop = messagesArea.scrollHeight;
            }
            scrollBottom();

            if (!hasConv) return;

            // ── SignalR ──────────────────────────────────────────────────────
            const conn = new signalR.HubConnectionBuilder()
                .withUrl('/chatHub')
                .withAutomaticReconnect([0, 2000, 5000, 10000])
                .build();

            conn.on('ReceiveMessage', function (payload) {
                if (payload.teacherId !== TEACHER_ID ||
                    payload.studentId !== STUDENT_ID ||
                    payload.courseId  !== COURSE_ID) return;

                // Remove optimistic copy
                const opt = messagesArea.querySelectorAll('.msg-row[data-optimistic]');
                if (opt.length) opt[opt.length - 1].remove();

                appendBubble({
                    message       : payload.message,
                    isFromTeacher : payload.isFromTeacher,
                    sentAt        : payload.sentAt,
                    sentDate      : payload.sentDate
                });
                scrollBottom();
            });

            conn.on('UserTyping', function (data) {
                if (!typingIndicator) return;
                if (data.isTyping) {
                    typingIndicator.classList.add('visible');
                    scrollBottom();
                } else {
                    typingIndicator.classList.remove('visible');
                }
            });

            conn.onreconnected(async () => {
                await conn.invoke('JoinConversation', TEACHER_ID, STUDENT_ID, COURSE_ID);
            });

            async function ensureConnected() {
                if (conn.state === signalR.HubConnectionState.Connected) return true;
                if (conn.state === signalR.HubConnectionState.Disconnected) {
                    try {
                        await conn.start();
                        await conn.invoke('JoinConversation', TEACHER_ID, STUDENT_ID, COURSE_ID);
                        return true;
                    } catch (e) { console.error('Reconnect failed', e); return false; }
                }
                for (let i = 0; i < 50; i++) {
                    await new Promise(r => setTimeout(r, 100));
                    if (conn.state === signalR.HubConnectionState.Connected) return true;
                }
                return false;
            }

            async function start() {
                try {
                    await conn.start();
                    await conn.invoke('JoinConversation', TEACHER_ID, STUDENT_ID, COURSE_ID);
                } catch (err) {
                    console.warn('SignalR start failed, retrying…', err);
                    setTimeout(start, 5000);
                }
            }
            start();

            // ── Send ─────────────────────────────────────────────────────────
            async function sendMessage() {
                if (!msgInput) return;
                const text = msgInput.value.trim();
                if (!text) return;

                msgInput.value = '';
                msgInput.style.height = 'auto';
                if (sendBtn) sendBtn.disabled = true;
                if (sendError) sendError.style.display = 'none';

                appendBubble({
                    message       : text,
                    isFromTeacher : false,
                    sentAt        : new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }),
                    sentDate      : new Date().toISOString().slice(0, 10),
                    optimistic    : true
                });
                scrollBottom();

                try {
                    const ok = await ensureConnected();
                    if (ok) await conn.invoke('SendMessage', TEACHER_ID, STUDENT_ID, COURSE_ID, text);
                    else throw new Error('No connection');
                } catch (err) {
                    console.error('Send failed', err);
                    if (sendError) {
                        sendError.style.display = 'block';
                        setTimeout(() => { if (sendError) sendError.style.display = 'none'; }, 4000);
                    }
                }

                stopTyping();
            }

            if (sendBtn) sendBtn.addEventListener('click', e => { e.preventDefault(); sendMessage(); });

            let typingTimer, isTyping = false;

            function startTyping() {
                if (!isTyping) {
                    isTyping = true;
                    conn.invoke('TypingStarted', TEACHER_ID, STUDENT_ID, COURSE_ID).catch(() => {});
                }
                clearTimeout(typingTimer);
                typingTimer = setTimeout(stopTyping, 2000);
            }

            function stopTyping() {
                if (isTyping) {
                    isTyping = false;
                    conn.invoke('TypingStopped', TEACHER_ID, STUDENT_ID, COURSE_ID).catch(() => {});
                }
                clearTimeout(typingTimer);
            }

            if (msgInput) {
                msgInput.addEventListener('input', function () {
                    this.style.height = 'auto';
                    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
                    if (sendBtn) sendBtn.disabled = this.value.trim().length === 0;
                    if (this.value.trim()) startTyping(); else stopTyping();
                });
                msgInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
                });
            }

            // ── Append bubble ────────────────────────────────────────────────
            let lastRenderedDate = null;

            function appendBubble({ message, isFromTeacher, sentAt, sentDate, optimistic }) {
                if (!messagesArea) return;

                const banner = messagesArea.querySelector('.msg-new-chat-banner');
                if (banner) banner.remove();

                if (sentDate && sentDate !== lastRenderedDate) {
                    lastRenderedDate = sentDate;
                    const today = new Date().toISOString().slice(0, 10);
                    const yest  = new Date(Date.now() - 86400000).toISOString().slice(0, 10);
                    const label = sentDate === today ? 'Today'
                                : sentDate === yest  ? 'Yesterday'
                                : new Date(sentDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
                    const sep = document.createElement('div');
                    sep.className = 'msg-date-sep';
                    sep.innerHTML = `<span>${label}</span>`;
                    messagesArea.appendChild(sep);
                }

                const fromMe = !isFromTeacher;
                const row    = document.createElement('div');
                row.className = `msg-row ${fromMe ? 'from-me' : 'from-them'}`;
                if (optimistic) { row.dataset.optimistic = '1'; row.style.opacity = '.75'; }

                const avatarHtml = fromMe ? '' : `<div class="msg-bubble-avatar">${escHtml(TEACHER_INI)}</div>`;
                row.innerHTML = `
                    ${avatarHtml}
                    <div>
                        <div class="msg-bubble">${escHtml(message)}</div>
                        <span class="msg-time">${sentAt}</span>
                    </div>`;
                messagesArea.appendChild(row);
            }

            function escHtml(str) {
                const d = document.createElement('div');
                d.textContent = str;
                return d.innerHTML;
            }

            // ── Sidebar search ────────────────────────────────────────────────
            const searchInput = document.getElementById('convSearch');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const q = this.value.toLowerCase();
                    document.querySelectorAll('.msg-teacher-item').forEach(item => {
                        const s = (item.dataset.search || '').toLowerCase();
                        item.style.display = s.includes(q) ? '' : 'none';
                    });
                    if (q) {
                        document.querySelectorAll('.msg-course-group').forEach(grp => {
                            const hasVisible = [...grp.querySelectorAll('.msg-teacher-item')]
                                .some(i => i.style.display !== 'none');
                            if (hasVisible) grp.classList.add('open');
                        });
                    }
                });
            }

        })();

        function toggleGroup(groupEl) {
            groupEl.classList.toggle('open');
        }
    </script>
}
