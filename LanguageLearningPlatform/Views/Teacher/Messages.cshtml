@using LanguageLearningPlatform.Web.Controllers
@model IEnumerable<TeacherConversationViewModel>

@{
    ViewData["Title"] = "Student Messages";
    var selectedStudentId = ViewBag.SelectedStudentId as string ?? "";
    var selectedCourseId = ViewBag.SelectedCourseId as Guid? ?? Guid.Empty;
    var allConvs = Model.ToList();
    var selected = allConvs.FirstOrDefault(c =>
        c.StudentId == selectedStudentId && c.CourseId == selectedCourseId);
}

@section Styles {
    <style>
        .msg-root {
            font-family: 'Plus Jakarta Sans',sans-serif;
            background: #F7F6F2;
            height: calc(100vh - 70px);
            display: flex;
            overflow: hidden;
        }

        .msg-sidebar {
            width: 300px;
            flex-shrink: 0;
            background: #fff;
            border-right: 1.5px solid #EDECEA;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .msg-sidebar-header {
            padding: 1.25rem 1.5rem 1rem;
            border-bottom: 1px solid #EDECEA;
        }

        .msg-sidebar-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1C1917;
            margin-bottom: 0;
        }

        .msg-conv-list {
            flex: 1;
            overflow-y: auto;
            padding: .5rem 0;
        }

        .msg-conv-item {
            display: flex;
            align-items: center;
            gap: .9rem;
            padding: .85rem 1.5rem;
            cursor: pointer;
            transition: background .15s;
            text-decoration: none;
            border-left: 3px solid transparent;
            position: relative;
        }

            .msg-conv-item:hover {
                background: #F7F6F2;
            }

            .msg-conv-item.active {
                background: #F5F3FF;
                border-left-color: #7C3AED;
            }

        .msg-conv-avatar {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: linear-gradient(135deg,#1D4ED8,#60A5FA);
            color: white;
            font-weight: 700;
            font-size: .88rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            position: relative;
        }

        .msg-unread-dot {
            position: absolute;
            top: -3px;
            right: -3px;
            width: 11px;
            height: 11px;
            background: #EF4444;
            border-radius: 50%;
            border: 2px solid white;
        }

        .msg-conv-info {
            flex: 1;
            min-width: 0;
        }

        .msg-conv-name {
            font-weight: 700;
            font-size: .87rem;
            color: #1C1917;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: .1rem;
        }

        .msg-conv-item.active .msg-conv-name {
            color: #5B21B6;
        }

        .msg-conv-course {
            font-size: .7rem;
            color: #A8A29E;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: .15rem;
        }

        .msg-conv-preview {
            font-size: .74rem;
            color: #78716C;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .msg-conv-meta {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: .25rem;
            flex-shrink: 0;
        }

        .msg-conv-time {
            font-size: .67rem;
            color: #A8A29E;
        }

        .msg-conv-badge {
            background: #7C3AED;
            color: white;
            font-size: .62rem;
            font-weight: 700;
            padding: .1rem .42rem;
            border-radius: 10px;
        }

        .msg-chat {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100%;
            min-width: 0;
        }

        .msg-chat-header {
            background: white;
            border-bottom: 1.5px solid #EDECEA;
            padding: 1rem 1.75rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-shrink: 0;
        }

        .msg-chat-header-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg,#1D4ED8,#60A5FA);
            color: white;
            font-weight: 700;
            font-size: .88rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .msg-chat-header-name {
            font-weight: 700;
            font-size: 1rem;
            color: #1C1917;
        }

        .msg-chat-header-course {
            font-size: .74rem;
            color: #A8A29E;
        }

        .msg-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem 1.75rem;
            display: flex;
            flex-direction: column;
            gap: .75rem;
        }

        .msg-date-sep {
            text-align: center;
            position: relative;
            margin: .5rem 0;
        }

            .msg-date-sep::before {
                content: '';
                position: absolute;
                left: 0;
                right: 0;
                top: 50%;
                height: 1px;
                background: #EDECEA;
            }

            .msg-date-sep span {
                position: relative;
                background: #F7F6F2;
                padding: 0 .75rem;
                font-size: .67rem;
                color: #A8A29E;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: .04em;
            }

        .msg-bubble-row {
            display: flex;
            gap: .6rem;
            align-items: flex-end;
        }

            .msg-bubble-row.from-me {
                flex-direction: row-reverse;
            }

        .msg-bubble-avatar {
            width: 28px;
            height: 28px;
            border-radius: 9px;
            background: linear-gradient(135deg,#1D4ED8,#60A5FA);
            color: white;
            font-weight: 700;
            font-size: .62rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .msg-bubble {
            max-width: 68%;
            padding: .75rem 1.1rem;
            border-radius: 18px;
            font-size: .875rem;
            line-height: 1.55;
            word-break: break-word;
        }

        .msg-bubble-row:not(.from-me) .msg-bubble {
            background: white;
            color: #1C1917;
            border: 1.5px solid #EDECEA;
            border-bottom-left-radius: 4px;
        }

        .msg-bubble-row.from-me .msg-bubble {
            background: linear-gradient(135deg,#1D4ED8,#1E40AF);
            color: white;
            border-bottom-right-radius: 4px;
            box-shadow: 0 4px 16px rgba(29,78,216,.25);
        }

        .msg-bubble-time {
            font-size: .62rem;
            color: #A8A29E;
            margin-top: .28rem;
            display: block;
        }

        .msg-bubble-row.from-me .msg-bubble-time {
            text-align: right;
            color: #C4B5D0;
        }

        .msg-input-area {
            background: white;
            border-top: 1.5px solid #EDECEA;
            padding: 1rem 1.75rem;
            flex-shrink: 0;
        }

        .msg-input-wrap {
            display: flex;
            align-items: flex-end;
            gap: .75rem;
            background: #F7F6F2;
            border: 1.5px solid #EDECEA;
            border-radius: 18px;
            padding: .65rem 1rem;
            transition: border-color .2s;
        }

            .msg-input-wrap:focus-within {
                border-color: #60A5FA;
                background: white;
                box-shadow: 0 0 0 3px rgba(96,165,250,.12);
            }

        .msg-textarea {
            flex: 1;
            border: none;
            background: transparent;
            outline: none;
            resize: none;
            font-size: .9rem;
            font-family: inherit;
            color: #1C1917;
            max-height: 120px;
            line-height: 1.5;
            padding: 0;
        }

            .msg-textarea::placeholder {
                color: #A8A29E;
            }

        .msg-send-btn {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            background: #1D4ED8;
            border: none;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .2s;
            flex-shrink: 0;
        }

            .msg-send-btn:hover {
                background: #1E40AF;
                transform: scale(1.05);
            }

            .msg-send-btn:disabled {
                background: #E7E5E0;
                cursor: not-allowed;
                transform: none;
            }

        .msg-empty {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 1rem;
            color: #A8A29E;
            text-align: center;
            padding: 2rem;
        }

            .msg-empty i {
                font-size: 3rem;
                opacity: .2;
            }

        .live-indicator {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            font-size: .68rem;
            color: #10B981;
            font-weight: 600;
        }

        .live-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #10B981;
            animation: livePulse 1.5s ease-in-out infinite;
        }
        @@keyframes livePulse {
            0%,100%

        {
            opacity: 1
        }

        50% {
            opacity: .4
        }

        }
        @@media(max - width:768px) {
            .msg-sidebar

        {
            width: 100%;
            height: 260px;
            border-right: none;
            border-bottom: 1.5px solid #EDECEA;
        }

        .msg-chat {
            height: calc(100vh - 340px);
        }

        }
    </style>
}

<div class="msg-root">
    <!-- SIDEBAR -->
    <div class="msg-sidebar">
        <div class="msg-sidebar-header">
            <div class="d-flex justify-content-between align-items-center">
                <div class="msg-sidebar-title"><i class="fas fa-inbox me-2" style="color:#1D4ED8;font-size:.9rem;"></i>Inbox</div>
                <span class="badge rounded-pill" style="background:#EFF6FF;color:#1D4ED8;font-size:.7rem;">@allConvs.Count conversations</span>
            </div>
        </div>
        <div class="msg-conv-list">
            @if (!allConvs.Any())
            {
                <div class="text-center py-4 px-3">
                    <i class="fas fa-inbox text-muted d-block mb-2" style="font-size:2rem;opacity:.3;"></i>
                    <p class="text-muted small mb-0">No messages from students yet.</p>
                </div>
            }
            @foreach (var conv in allConvs)
            {
                var isActive = conv.StudentId == selectedStudentId && conv.CourseId == selectedCourseId;
                var initials = string.Concat(conv.StudentName.Split(' ').Take(2).Select(p => p.Length > 0 ? p[0].ToString() : ""));
                var timeStr = conv.LastMessageAt.Date == DateTime.Today ? conv.LastMessageAt.ToString("HH:mm")
                : conv.LastMessageAt.Date == DateTime.Today.AddDays(-1) ? "Yesterday"
                : conv.LastMessageAt.ToString("MMM dd");
                <a href="@Url.Action("Messages", "Teacher", new { selectedStudentId = conv.StudentId, selectedCourseId = conv.CourseId })"
                   class="msg-conv-item @(isActive ? "active" : "")">
                    <div class="msg-conv-avatar">
                        @initials
                        @if (conv.UnreadCount > 0)
                        {
                            <div class="msg-unread-dot"></div>
                        }
                    </div>
                    <div class="msg-conv-info">
                        <div class="msg-conv-name">@conv.StudentName</div>
                        <div class="msg-conv-course"><i class="fas fa-book" style="font-size:.58rem;"></i> @conv.CourseName</div>
                        <div class="msg-conv-preview">@conv.LastMessage</div>
                    </div>
                    <div class="msg-conv-meta">
                        <span class="msg-conv-time">@timeStr</span>
                        @if (conv.UnreadCount > 0)
                        {
                            <span class="msg-conv-badge">@conv.UnreadCount</span>
                        }
                    </div>
                </a>
            }
        </div>
    </div>

    <!-- CHAT PANEL -->
    <div class="msg-chat">
        @if (selected != null)
        {
            var studentInitials = string.Concat(selected.StudentName.Split(' ').Take(2).Select(p => p.Length > 0 ? p[0].ToString() : ""));
            <div class="msg-chat-header">
                <div class="msg-chat-header-avatar">@studentInitials</div>
                <div style="flex:1;min-width:0;">
                    <div class="msg-chat-header-name">@selected.StudentName</div>
                    <div class="msg-chat-header-course">
                        <i class="fas fa-book me-1"></i>@selected.CourseName
                        &nbsp;·&nbsp;
                        <span class="live-indicator"><span class="live-dot"></span>Live</span>
                    </div>
                </div>
                <a asp-controller="Courses" asp-action="Details" asp-route-id="@selected.CourseId"
                   class="btn btn-sm" style="background:#EFF6FF;color:#1D4ED8;border-radius:9px;font-size:.74rem;font-weight:600;border:none;text-decoration:none;">
                    <i class="fas fa-external-link-alt me-1"></i>Course
                </a>
            </div>

            <!-- Messages -->
            <div class="msg-messages" id="messagesArea">
                @{
                    DateTime? lastDate = null;
                    foreach (var msg in selected.Messages)
                    {
                        var msgDate = msg.SentAt.Date;
                        if (lastDate == null || lastDate != msgDate)
                        {
                            var dateLbl = msgDate == DateTime.Today ? "Today"
                            : msgDate == DateTime.Today.AddDays(-1) ? "Yesterday"
                            : msgDate.ToString("MMMM d, yyyy");
                            <div class="msg-date-sep"><span>@dateLbl</span></div>
                            lastDate = msgDate;
                        }
                        var fromMe = msg.IsFromTeacher;
                        var bubbleInitials = fromMe ? "Me" : studentInitials;
                        <div class="msg-bubble-row @(fromMe ? "from-me" : "")" data-msg-id="@msg.Id">
                            @if (!fromMe)
                            {
                                <div class="msg-bubble-avatar">@bubbleInitials</div>
                            }
                            <div>
                                <div class="msg-bubble">@msg.Message</div>
                                <span class="msg-bubble-time">@msg.SentAt.ToString("HH:mm")</span>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Input -->
            <div class="msg-input-area">
                <form asp-action="ReplyMessage" asp-controller="Teacher" method="post" id="replyForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="studentId" value="@selected.StudentId" />
                    <input type="hidden" name="courseId" value="@selected.CourseId" />
                    <div class="msg-input-wrap">
                        <textarea class="msg-textarea" name="message" id="msgTextarea" rows="1"
                              placeholder="Reply to @selected.StudentName…" required></textarea>
                        <button type="submit" class="msg-send-btn" id="sendBtn" disabled>
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </form>
            </div>
        }
        else if (!allConvs.Any())
        {
            <div class="msg-empty">
                <i class="fas fa-comment-slash"></i>
                <h5>No messages yet</h5>
                <p class="small">Students will appear here when they message you about your courses.</p>
            </div>
        }
        else
        {
            <div class="msg-empty">
                <i class="fas fa-hand-point-left"></i>
                <h5>Select a conversation</h5>
                <p class="small">Choose a student from the sidebar.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Scroll messages to bottom
            const area = document.getElementById('messagesArea');
            if (area) area.scrollTop = area.scrollHeight;

            // Auto-resize textarea
            const textarea = document.getElementById('msgTextarea');
            const sendBtn = document.getElementById('sendBtn');
            if (textarea) {
                textarea.addEventListener('input', () => {
                    textarea.style.height = 'auto';
                    textarea.style.height = Math.min(textarea.scrollHeight, 120) + 'px';
                    if (sendBtn) sendBtn.disabled = textarea.value.trim().length === 0;
                });
                textarea.addEventListener('keydown', e => {
                    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                        e.preventDefault();
                        if (textarea.value.trim()) document.getElementById('replyForm')?.submit();
                    }
                });
            }

            // ── Live polling: check for new messages every 5 seconds ──
            @if (selected != null)
            {
                    <text>
                    const STUDENT_ID = '@selected.StudentId';
                    const COURSE_ID  = '@selected.CourseId';
                    let lastMsgId = null;

                    // Collect existing message IDs
                    document.querySelectorAll('[data-msg-id]').forEach(el => { lastMsgId = el.dataset.msgId; });

                    async function pollMessages() {
                        try {
                            const resp = await fetch(`/Teacher/PollMessages?studentId=${STUDENT_ID}&courseId=${COURSE_ID}&after=${encodeURIComponent(lastMsgId || '')}`, {
                                credentials: 'include'
                            });
                            if (!resp.ok) return;
                            const data = await resp.json();
                            if (data.messages && data.messages.length > 0) {
                                const area = document.getElementById('messagesArea');
                                data.messages.forEach(msg => {
                                    lastMsgId = msg.id;
                                    const row = document.createElement('div');
                                    row.className = `msg-bubble-row${msg.isFromTeacher ? ' from-me' : ''}`;
                                    row.dataset.msgId = msg.id;
                                    if (!msg.isFromTeacher) {
                                        const av = document.createElement('div');
                                        av.className = 'msg-bubble-avatar';
                                        av.textContent = '@@studentInitials';
                                        row.appendChild(av);
                                    }
                                    const inner = document.createElement('div');
                                    inner.innerHTML = `<div class="msg-bubble">${escapeHtml(msg.message)}</div><span class="msg-bubble-time">${msg.sentAt}</span>`;
                                    row.appendChild(inner);
                                    area.appendChild(row);
                                });
                                area.scrollTop = area.scrollHeight;
                            }
                        } catch(e) { /* silent */ }
                    }

                    function escapeHtml(str) {
                        const d = document.createElement('div');
                        d.appendChild(document.createTextNode(str));
                        return d.innerHTML;
                    }

                    // Poll every 5 seconds
                    setInterval(pollMessages, 5000);
                    </text>
            }
        });
    </script>
}
